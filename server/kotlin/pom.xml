    <groupId>com.metamug</groupId>
    <artifactId>r2-kotlin-scripting</artifactId>
    <version>1</version>
    <packaging>pom</packaging>
    <dependencies>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-scripting-jsr223</artifactId>
            <version>1.9.24</version>
        </dependency>
    </dependencies>
</project>
